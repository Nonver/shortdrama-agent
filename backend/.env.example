# ============================================================
# AI 短剧剧本生成 Agent · 环境变量模板
# ------------------------------------------------------------
# 用法：把本文件复制为同目录下的 `.env`，按需填写。
#       Windows:  copy .env.example .env
#       macOS/Linux:  cp .env.example .env
#
# 说明：ARK_API_KEY / VOLC_TTS_API_KEY 都是可选的。
#       不填时剧本生成会自动降级为「规则 + 知识库」兜底生成器，
#       服务照常可用（只是没有真实大模型输出、生图、生视频、配音）。
# ============================================================

# ---------------- 安全（生产环境务必修改）----------------
# JWT 签名密钥，请改成足够长的随机字符串
JWT_SECRET=change-me-to-a-long-random-string
# 会话密钥
SESSION_SECRET=change-me-too

# ---------------- 后台超管种子账号 ----------------
# 仅首次启动 seed 时创建；首次登录后请立即改密
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_before_deploy

# ---------------- 数据库 ----------------
# 留空 = 使用本地 SQLite（零配置，文件落在 ../data/app.db）
# 要切 MySQL，取消下一行注释并填自己的连接串：
# DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/shortdrama?charset=utf8mb4

# ============================================================
# 火山方舟（对话 / 角色 / 生图 / 生视频 / 向量化）
# 控制台：https://console.volcengine.com/ark
# ============================================================
ARK_API_KEY=

# ---- 模型 endpoint（以下默认值均已实测可用，一般不用改）----
# 对话生成：默认快速档（实测 7.9s 出短句）
# 追求更高剧本质量可换成 doubao-seed-2-1-pro-260628（但出 token 慢、易超时）
ARK_MODEL_CHAT=doubao-seed-2-0-mini-260428
ARK_MODEL_CHARACTER=doubao-seed-character-260628
ARK_MODEL_MINI=doubao-seed-2-0-mini-260428
ARK_MODEL_VISION=doubao-seed-2-1-turbo-260628
# 文生图
ARK_MODEL_IMAGE=doubao-seedream-4-0-250828
# 文生视频
ARK_MODEL_VIDEO=doubao-seedance-1-0-pro-fast-251015
# 文本向量化（RAG 语义检索用）
# 若在方舟「在线推理」建了纯文本 embedding 接入点，可改为 ep-xxxxxxxxx
ARK_MODEL_EMBEDDING=doubao-embedding-vision-251215

# ============================================================
# 豆包语音（分角色配音）
# 注意：这是独立于方舟的另一套服务（火山引擎·语音技术），
#       走 openspeech.bytedance.com，密钥与 ARK_API_KEY 不通用。
# ============================================================
VOLC_TTS_API_KEY=
VOLC_TTS_APP_ID=
VOLC_TTS_CLUSTER=volcano_tts
